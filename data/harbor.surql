DEFINE FIELD OVERWRITE name ON customer TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE phone ON customer TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE region ON customer TYPE 'North' | 'South' PERMISSIONS FULL;



