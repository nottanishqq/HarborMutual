-- ------------------------------
-- OPTION
-- ------------------------------

OPTION IMPORT;

-- ------------------------------
-- ACCESSES
-- ------------------------------


-- ------------------------------
-- ANALYZERS
-- ------------------------------

DEFINE ANALYZER en TOKENIZERS CLASS FILTERS LOWERCASE, SNOWBALL(ENGLISH);

-- ------------------------------
-- TABLE: adjuster
-- ------------------------------

DEFINE TABLE adjuster TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE id = $auth.id, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE email ON adjuster TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON adjuster TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE pass ON adjuster TYPE string PERMISSIONS FOR select NONE, FOR create, update FULL;
DEFINE FIELD OVERWRITE region ON adjuster TYPE 'North' | 'South' PERMISSIONS FULL;

DEFINE INDEX adjuster_email ON adjuster FIELDS email UNIQUE;


-- ------------------------------
-- TABLE DATA: adjuster
-- ------------------------------

INSERT [ { email: 'asha.north@harbor.example', id: adjuster:1, name: 'Asha Rao', pass: '$argon2id$v=19$m=19456,t=2,p=1$6ARhTtmPLfOkZ+YEiOkE6g$IS/x6TRkdiulhYQogO3W/O+10YlQygKhBPACYJNnkmM', region: 'North' }, { email: 'ben.south@harbor.example', id: adjuster:2, name: 'Ben Clarke', pass: '$argon2id$v=19$m=19456,t=2,p=1$tlrJBBt06qKD9ZrWYX/GAw$IxccMOmM2wgM6WMGL9J4gPmUu+vdMOI3cLOnjofXC60', region: 'South' }, { email: 'nora.north@harbor.example', id: adjuster:3, name: 'Nora Evans', pass: '$argon2id$v=19$m=19456,t=2,p=1$LQmgAPTdwi/1DXGo7MNWkw$10QWJI2/UejWj1K4nsrniZgjjzISD5fMUK5/ZCDuhr8', region: 'North' }, { email: 'omar.south@harbor.example', id: adjuster:4, name: 'Omar Khan', pass: '$argon2id$v=19$m=19456,t=2,p=1$iV/OD1nIRN+UthOzfcUgKg$ZBo93OmojkKzljlhiYp7DnUY1kbLVqeCQrZLlhK3LAc', region: 'South' } ];

-- ------------------------------
-- TABLE: claim
-- ------------------------------

DEFINE TABLE claim TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE region = $auth.region, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE adjuster ON claim TYPE record<adjuster> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE amount ON claim TYPE decimal ASSERT $value > 0 PERMISSIONS FULL;
DEFINE FIELD OVERWRITE description ON claim TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding ON claim TYPE array<float> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding.* ON claim TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE filed_at ON claim TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE number ON claim TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE payments ON claim TYPE array<object> DEFAULT [] PERMISSIONS FULL;
DEFINE FIELD OVERWRITE payments.* ON claim TYPE object PERMISSIONS FULL;
DEFINE FIELD OVERWRITE payments.*.amount ON claim TYPE decimal PERMISSIONS FULL;
DEFINE FIELD OVERWRITE payments.*.paid_at ON claim TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE policy ON claim TYPE record<policy> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE region ON claim TYPE 'North' | 'South' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE status ON claim TYPE 'open' | 'approved' | 'rejected' PERMISSIONS FULL;

DEFINE INDEX claim_number ON claim FIELDS number UNIQUE;
DEFINE INDEX claim_region_status ON claim FIELDS region, status;
DEFINE INDEX claim_text ON claim FIELDS description FULLTEXT ANALYZER en BM25(1.2,0.75);
DEFINE INDEX claim_vec ON claim FIELDS embedding HNSW DIMENSION 384 DIST COSINE TYPE F32 EFC 150 M 12 M0 24 LM 0.40242960438184466f;


-- ------------------------------
-- TABLE DATA: claim
-- ------------------------------

