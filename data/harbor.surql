-- ------------------------------
-- TABLE: involved_in
-- ------------------------------

DEFINE TABLE involved_in TYPE RELATION IN party OUT claim ENFORCED SCHEMAFULL PERMISSIONS FOR select WHERE out.region = $auth.region, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE in ON involved_in TYPE record<party> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON involved_in TYPE record<claim> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE role ON involved_in TYPE 'witness' | 'repairer' | 'treating_clinic' | 'third_party' PERMISSIONS FULL;

DEFINE INDEX involved_unique ON involved_in FIELDS in, out UNIQUE;


-- ------------------------------
-- TABLE DATA: involved_in
-- ------------------------------

