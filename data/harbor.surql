-- ------------------------------
-- TABLE: party
-- ------------------------------

DEFINE TABLE party TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select FULL, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE kind ON party TYPE 'person' | 'repair_shop' | 'clinic' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON party TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE phone ON party TYPE string PERMISSIONS FULL;



