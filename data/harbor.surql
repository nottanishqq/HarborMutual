-- ------------------------------
-- TABLE: memory
-- ------------------------------

DEFINE TABLE memory TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create WHERE adjuster = $auth.id, FOR update, delete NONE;

DEFINE FIELD OVERWRITE adjuster ON memory TYPE record<adjuster> DEFAULT $auth.id PERMISSIONS FULL;
DEFINE FIELD OVERWRITE at ON memory TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding ON memory TYPE array<float> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding.* ON memory TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE text ON memory TYPE string PERMISSIONS FULL;

DEFINE INDEX memory_vec ON memory FIELDS embedding HNSW DIMENSION 384 DIST COSINE TYPE F32 EFC 150 M 12 M0 24 LM 0.40242960438184466f;


-- ------------------------------
-- TABLE DATA: memory
-- ------------------------------


-- ------------------------------
-- TABLE: note
-- ------------------------------

DEFINE TABLE note TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE claim.region = $auth.region, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE author ON note TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE body ON note TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE channel ON note TYPE 'email' | 'phone' | 'letter' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE claim ON note TYPE record<claim> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE sent_at ON note TYPE datetime PERMISSIONS FULL;

DEFINE INDEX note_claim ON note FIELDS claim;


-- ------------------------------
