-- ------------------------------
-- TABLE: policy
-- ------------------------------

DEFINE TABLE policy TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE customer.region = $auth.region, FOR create, update, delete NONE;

DEFINE FIELD OVERWRITE customer ON policy TYPE record<customer> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE kind ON policy TYPE 'home' | 'car' PERMISSIONS FULL;
DEFINE FIELD OVERWRITE premium ON policy TYPE decimal PERMISSIONS FULL;
DEFINE FIELD OVERWRITE start_date ON policy TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE terms ON policy TYPE none | object FLEXIBLE PERMISSIONS FULL;



-- ------------------------------
-- TABLE DATA: policy
-- ------------------------------

